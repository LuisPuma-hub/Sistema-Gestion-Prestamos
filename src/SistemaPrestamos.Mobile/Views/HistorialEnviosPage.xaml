<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.HistorialEnviosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            BackgroundColor="#15307A"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="16,48,16,20">
            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                <Grid
                    Grid.Column="0"
                    HeightRequest="44"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Image
                        Source="ic_chev_l_w.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    Text="Historial de envíos"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Column="2"
                    WidthRequest="44"
                    BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="10">

                <CollectionView
                    x:Name="EnviosCollection"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="14,12"
                                Margin="0,0,0,10"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="44"
                                        WidthRequest="44"
                                        BackgroundColor="#DBEAFE"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        VerticalOptions="Center">
                                        <Image
                                            Source="ic_bell.png"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Destinatario}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#111827" />
                                        <Label
                                            Text="{Binding Evento}"
                                            FontSize="13"
                                            TextColor="#6B7280" />
                                        <Label
                                            Text="{Binding FechaCreacion, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                            FontSize="12"
                                            TextColor="#9CA3AF" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Estado}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#16A34A"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label
                    x:Name="EstadoLabel"
                    IsVisible="False"
                    TextColor="#6B7280"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
