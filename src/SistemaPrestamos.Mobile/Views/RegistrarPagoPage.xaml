<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.RegistrarPagoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Registrar pago">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="14">

            <Label
                Text="Nuevo pago"
                FontSize="24"
                FontAttributes="Bold" />

            <Picker
                x:Name="PrestamoPicker"
                Title="Seleccione un préstamo activo"
                ItemDisplayBinding="{Binding ClienteNombre}" />

            <Label
                x:Name="PrestamoInfoLabel"
                FontSize="13" />

            <Entry
                x:Name="MontoEntry"
                Placeholder="Monto (S/)"
                Keyboard="Numeric"
                ClearButtonVisibility="WhileEditing" />

            <Label
                Text="Fecha de pago" />
            <Grid
                ColumnDefinitions="Auto,*,Auto,Auto"
                ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    Text="-"
                    WidthRequest="44"
                    Clicked="OnDiaMenosClicked" />
                <Entry
                    Grid.Column="1"
                    x:Name="FechaEntry"
                    IsReadOnly="True"
                    HorizontalTextAlignment="Center" />
                <Button
                    Grid.Column="2"
                    Text="+"
                    WidthRequest="44"
                    Clicked="OnDiaMasClicked" />
                <Button
                    Grid.Column="3"
                    Text="Últ. vto"
                    Clicked="OnUltimoVencimientoClicked" />
            </Grid>

            <Entry
                x:Name="ComprobanteEntry"
                Placeholder="Comprobante (opcional)"
                ClearButtonVisibility="WhileEditing" />

            <Editor
                x:Name="ObservacionesEditor"
                Placeholder="Observaciones (opcional)"
                AutoSize="TextChanges" />

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Regla de aplicación"
                        FontAttributes="Bold" />
                    <Label
                        Text="El pago se aplica primero al interés pendiente y el resto al capital."
                        FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="GuardarButton"
                Text="Guardar pago"
                Clicked="OnGuardarClicked" />

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
