<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.BloqueoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC">

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            BackgroundColor="#512BD4"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="24,56,24,40">
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                <Label
                    Text="Buenos días,"
                    FontSize="15"
                    TextColor="#DDD6FE"
                    HorizontalTextAlignment="Center" />
                <Label
                    x:Name="NombreLabel"
                    Text=""
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout
            Grid.Row="1"
            Padding="32,8,32,32"
            Spacing="14">

            <Border
                HeightRequest="140"
                WidthRequest="140"
                HorizontalOptions="Center"
                BackgroundColor="#EDE9FE"
                Stroke="#C4B5FD"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 70"
                Margin="0,-70,0,0"
                Padding="0">
                <Label
                    Text="🫆"
                    FontSize="64"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Text="Toca para desbloquear"
                FontSize="16"
                TextColor="#111827"
                HorizontalTextAlignment="Center" />

            <Button
                x:Name="HuellaButton"
                Text="Desbloquear con huella"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="52"
                Clicked="OnHuellaClicked" />

            <Button
                x:Name="ClaveButton"
                Text="Usar contraseña"
                BackgroundColor="Transparent"
                TextColor="#512BD4"
                BorderColor="#512BD4"
                BorderWidth="1.5"
                CornerRadius="12"
                HeightRequest="52"
                Clicked="OnClaveClicked" />

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="#512BD4"
                HorizontalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                TextColor="#DC2626"
                IsVisible="False"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Toca el botón y pon tu dedo en el sensor del equipo."
                FontSize="13"
                TextColor="#6B7280"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
