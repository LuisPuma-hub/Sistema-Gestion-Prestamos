<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC">

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            BackgroundColor="#15307A"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="24,48,24,32">
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border
                        HeightRequest="48"
                        WidthRequest="48"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Center">
                        <Image
                            Source="logo_credivzla.png"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            Text="CrediVzla"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            Text="SISTEMA DE PRÉSTAMOS"
                            FontSize="10"
                            TextColor="#BFDBFE"
                            CharacterSpacing="1" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Label
                    Text="Bienvenido"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="White"
                    Margin="0,16,0,0" />

                <Label
                    Text="Ingresa con tu cuenta de cobrador"
                    FontSize="14"
                    TextColor="#DBEAFE" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="24"
                Spacing="6">

                <Label
                    Text="Correo electrónico"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Border
                    x:Name="EmailBox"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E5E7EB"
                    BackgroundColor="White"
                    Padding="12,2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmailBoxTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Image
                            Grid.Column="0"
                            Source="ic_mail.png"
                            WidthRequest="22"
                            HeightRequest="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Entry
                            Grid.Column="1"
                            x:Name="EmailEntry"
                            Placeholder="correo@empresa.com"
                            Keyboard="Email"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label
                    Text="Contraseña"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#111827"
                    Margin="0,10,0,0" />

                <Border
                    x:Name="ClaveBox"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E5E7EB"
                    BackgroundColor="White"
                    Padding="12,2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClaveBoxTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="34,*,34" ColumnSpacing="8" VerticalOptions="Center">
                        <Image
                            Grid.Column="0"
                            Source="ic_lock.png"
                            WidthRequest="22"
                            HeightRequest="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Entry
                            Grid.Column="1"
                            x:Name="PasswordEntry"
                            Placeholder="Ingresa tu contraseña"
                            IsPassword="True"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Column="2"
                            x:Name="OjoIcon"
                            Source="ic_eye.png"
                            WidthRequest="22"
                            HeightRequest="22"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOjoClicked" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>

                <Button
                    x:Name="LoginButton"
                    Text="Ingresar"
                    BackgroundColor="#15307A"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,16,0,0"
                    Clicked="OnLoginClicked" />

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#15307A"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="#DC2626"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="¿Olvidaste tu contraseña?"
                    FontSize="13"
                    TextColor="#15307A"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOlvidoClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <Border
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#DBEAFE"
                    Padding="14,12"
                    Margin="0,8,0,0">
                    <HorizontalStackLayout Spacing="8">
                        <Image
                            Source="ic_info_p.png"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Start" />
                        <Label FontSize="13" TextColor="#1E3A8A">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Para soporte contacta a tu administrador o llama al " />
                                    <Span Text="01-234-5678" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
