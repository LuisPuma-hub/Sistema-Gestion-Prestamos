<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.DetalleClientePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del cliente">

    <Grid>
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="14">

            <Label
                x:Name="NombreLabel"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="EstadoLabel"
                FontSize="16"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Datos personales"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="TipoDocumentoPicker"
                        Title="Tipo de documento"
                        IsEnabled="False">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>DNI</x:String>
                                <x:String>CE</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Entry
                        x:Name="NumeroDocumentoEntry"
                        Placeholder="Número de documento"
                        Keyboard="Numeric"
                        IsEnabled="False" />

                    <Entry
                        x:Name="NombresEntry"
                        Placeholder="Nombres"
                        IsEnabled="False" />

                    <Entry
                        x:Name="ApellidosEntry"
                        Placeholder="Apellidos"
                        IsEnabled="False" />

                    <Entry
                        x:Name="TelefonoEntry"
                        Placeholder="Teléfono"
                        Keyboard="Telephone"
                        IsEnabled="False" />

                    <Entry
                        x:Name="DireccionEntry"
                        Placeholder="Dirección"
                        IsEnabled="False" />

                    <Entry
                        x:Name="ReferenciaEntry"
                        Placeholder="Referencia de dirección"
                        IsEnabled="False" />

                    <Editor
                        x:Name="ObservacionesEditor"
                        Placeholder="Observaciones"
                        AutoSize="TextChanges"
                        IsEnabled="False" />

                    <Label
                        x:Name="FechaLabel"
                        FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Aval"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="GaranteLabel"
                        Text="Sin aval registrado."
                        FontSize="14" />

                    <Picker
                        x:Name="AvalOpcionPicker"
                        Title="Opción de aval"
                        SelectedIndexChanged="OnAvalOpcionChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Sin aval</x:String>
                                <x:String>Cliente existente</x:String>
                                <x:String>Nuevo aval</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Picker
                        x:Name="AvalClientePicker"
                        Title="Seleccione cliente como aval"
                        ItemDisplayBinding="{Binding NombreCompleto}"
                        IsVisible="False" />

                    <VerticalStackLayout
                        x:Name="AvalNuevoLayout"
                        Spacing="8"
                        IsVisible="False">
                        <Entry
                            x:Name="AvalNombresEntry"
                            Placeholder="Nombres del aval" />
                        <Entry
                            x:Name="AvalApellidosEntry"
                            Placeholder="Apellidos del aval" />
                        <Entry
                            x:Name="AvalTelefonoEntry"
                            Placeholder="Teléfono del aval"
                            Keyboard="Telephone" />
                        <Entry
                            x:Name="AvalDireccionEntry"
                            Placeholder="Dirección del aval (opcional)" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="GuardarAvalButton"
                        Text="Guardar aval"
                        IsVisible="False"
                        Clicked="OnGuardarAvalClicked" />

                    <Button
                        x:Name="QuitarAvalButton"
                        Text="Quitar aval"
                        IsVisible="False"
                        Clicked="OnQuitarAvalClicked" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Préstamos"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="PrestamosResumenLabel"
                        Text="Sin préstamos registrados."
                        FontSize="14" />
                    <CollectionView
                        x:Name="PrestamosCollection"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="OnPrestamoTapped"
                                            CommandParameter="{Binding Id}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            Text="{Binding CapitalInicial, StringFormat='Capital: S/ {0:N2}'}"
                                            FontSize="14"
                                            FontAttributes="Bold" />
                                        <Label
                                            Text="{Binding CapitalPendiente, StringFormat='Pendiente: S/ {0:N2}'}"
                                            FontSize="13" />
                                        <Label
                                            Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                            FontSize="13" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Recibo de domicilio"
                        FontAttributes="Bold" />
                    <Image
                        x:Name="FotoImage"
                        HeightRequest="180"
                        Aspect="AspectFill"
                        IsVisible="False">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFotoTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label
                        x:Name="FotoLabel"
                        Text="Sin foto registrada."
                        FontSize="13" />
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            x:Name="CamaraButton"
                            Text="Cámara"
                            Clicked="OnCamaraClicked" />
                        <Button
                            Grid.Column="1"
                            x:Name="GaleriaButton"
                            Text="Galería"
                            Clicked="OnGaleriaClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Cambiar estado"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="EstadoPicker"
                        Title="Estado">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Activo</x:String>
                                <x:String>En observación</x:String>
                                <x:String>Moroso</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Button
                        x:Name="CambiarEstadoButton"
                        Text="Guardar estado"
                        Clicked="OnCambiarEstadoClicked" />
                </VerticalStackLayout>
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    x:Name="EditarButton"
                    Text="Editar"
                    Clicked="OnEditarClicked" />
                <Button
                    Grid.Column="1"
                    x:Name="GuardarButton"
                    Text="Guardar"
                    IsVisible="False"
                    Clicked="OnGuardarClicked" />
            </Grid>

            <Button
                x:Name="WhatsappButton"
                Text="WhatsApp"
                Clicked="OnWhatsappClicked" />

            <Button
                x:Name="EliminarButton"
                Text="Eliminar cliente"
                IsVisible="False"
                Clicked="OnEliminarClicked" />

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

        <Grid
            x:Name="FotoOverlay"
            BackgroundColor="#CC000000"
            IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarFoto" />
            </Grid.GestureRecognizers>

            <Border
                Margin="24"
                Padding="0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <Grid>
                    <Image
                        x:Name="FotoCompletaImage"
                        Aspect="AspectFit"
                        HeightRequest="500" />
                    <Button
                        Text="X"
                        FontAttributes="Bold"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="8"
                        Clicked="OnCerrarFoto" />
                </Grid>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
