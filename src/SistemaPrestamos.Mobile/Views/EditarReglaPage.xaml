<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.EditarReglaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            BackgroundColor="#15307A"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="16,48,16,20">
            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                <Grid
                    Grid.Column="0"
                    HeightRequest="44"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Image
                        Source="ic_chev_l_w.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    x:Name="TituloLabel"
                    Text="Nueva regla"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Column="2"
                    WidthRequest="44"
                    BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="NOMBRE" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Entry
                            x:Name="NombreEntry"
                            Placeholder="Ej. Vencen hoy"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="EVENTO" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Picker x:Name="EventoPicker" Title="Selecciona el evento" />
                        <Label Text="CANAL" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Picker x:Name="CanalPicker" Title="Selecciona el canal" SelectedIndexChanged="OnCanalChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="HORA DE ENVÍO (LIMA)" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Label
                            x:Name="HoraLimaLabel"
                            FontSize="13"
                            TextColor="#1E3A8A" />
                        <TimePicker
                            x:Name="HoraPicker"
                            Format="HH:mm"
                            FontSize="20"
                            TextColor="#111827" />
                        <Label Text="DÍAS" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" x:Name="Dia0" Text="L" Clicked="OnDiaClicked" />
                            <Button Grid.Column="1" x:Name="Dia1" Text="M" Clicked="OnDiaClicked" />
                            <Button Grid.Column="2" x:Name="Dia2" Text="X" Clicked="OnDiaClicked" />
                            <Button Grid.Column="3" x:Name="Dia3" Text="J" Clicked="OnDiaClicked" />
                            <Button Grid.Column="4" x:Name="Dia4" Text="V" Clicked="OnDiaClicked" />
                            <Button Grid.Column="5" x:Name="Dia5" Text="S" Clicked="OnDiaClicked" />
                            <Button Grid.Column="6" x:Name="Dia6" Text="D" Clicked="OnDiaClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="PlantillaCard"
                    Padding="16"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PLANTILLA WHATSAPP" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Picker x:Name="PlantillaPicker" Title="Selecciona la plantilla" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="GuardarButton"
                    Text="Guardar regla"
                    BackgroundColor="#15307A"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnGuardarClicked" />

                <Button
                    x:Name="ProbarButton"
                    Text="Probar ahora"
                    BackgroundColor="#DBEAFE"
                    TextColor="#1E3A8A"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    IsVisible="False"
                    Clicked="OnProbarClicked" />

                <Border
                    x:Name="DestinoCard"
                    Padding="16"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="DESTINATARIO DE PRUEBA (WHATSAPP)" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Picker x:Name="ClientePicker" Title="Selecciona el cliente" SelectedIndexChanged="OnClienteChanged" />
                        <Picker x:Name="PrestamoPicker" Title="Selecciona el préstamo" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="EliminarButton"
                    Text="Eliminar regla"
                    BackgroundColor="#FEE2E2"
                    TextColor="#991B1B"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    IsVisible="False"
                    Clicked="OnEliminarClicked" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="#DC2626"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
