<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.UsuariosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            BackgroundColor="#1D4ED8"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="16,48,16,20">
            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                <Grid
                    Grid.Column="0"
                    HeightRequest="44"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Image
                        Source="ic_chev_l_w.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    Text="Usuarios"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
                <Border
                    Grid.Column="2"
                    BackgroundColor="#3B82F6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    HeightRequest="44"
                    WidthRequest="44"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNuevoUsuarioClicked" />
                    </Border.GestureRecognizers>
                    <Image Source="ic_plus_w.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="16,12,16,0">
            <CollectionView
                x:Name="UsuariosCollection"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="14,12"
                            Margin="0,0,0,10"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnUsuarioTapped"
                                    CommandParameter="{Binding Id}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    Grid.Column="0"
                                    HeightRequest="52"
                                    WidthRequest="52"
                                    BackgroundColor="#DBEAFE"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 26"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Inicial}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="#1D4ED8"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding NombreCompleto}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#111827" />
                                    <Label
                                        Text="{Binding Email}"
                                        FontSize="13"
                                        TextColor="#6B7280" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center"
                                    BackgroundColor="{Binding Rol, Converter={StaticResource EstadoFondo}}">
                                    <Label
                                        Text="{Binding Rol}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{Binding Rol, Converter={StaticResource EstadoTexto}}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="#1D4ED8"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="EstadoLabel"
                IsVisible="False"
                TextColor="#6B7280"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Padding="16,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button
                Grid.Column="0"
                x:Name="ReintentarButton"
                Text="Reintentar"
                BackgroundColor="#1D4ED8"
                TextColor="White"
                CornerRadius="12"
                IsVisible="False"
                Clicked="OnReintentarClicked" />
            <Border
                Grid.Column="1"
                BackgroundColor="#1D4ED8"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30"
                HeightRequest="60"
                WidthRequest="60">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNuevoUsuarioClicked" />
                </Border.GestureRecognizers>
                <Image Source="ic_plus_w.png" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

    </Grid>

</ContentPage>
