<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SistemaPrestamos.Mobile.MainPage"
    Title="Dashboard">

    <RefreshView
        x:Name="RefreshView"
        Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout
                Padding="24"
                Spacing="16">

                <Label
                    Text="Dashboard"
                    FontSize="32"
                    FontAttributes="Bold" />

                <Label
                    x:Name="SaludoLabel"
                    Text="Sistema de Gestión de Préstamos"
                    FontSize="16" />

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="12">

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                x:Name="ClientesValorLabel"
                                Text="-"
                                FontSize="26"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Clientes"
                                FontSize="13"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                x:Name="PrestamosValorLabel"
                                Text="-"
                                FontSize="26"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Préstamos activos"
                                FontSize="13"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                x:Name="CapitalValorLabel"
                                Text="-"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Capital pendiente"
                                FontSize="13"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                x:Name="MoraValorLabel"
                                Text="-"
                                FontSize="26"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="En mora"
                                FontSize="13"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Padding="16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                x:Name="PagosHoyValorLabel"
                                Text="-"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Cobrado hoy"
                                FontSize="13"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <Label
                    x:Name="ErrorLabel"
                    TextColor="Red"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="12">

                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Clientes"
                        Clicked="OnClientesClicked" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Préstamos"
                        Clicked="OnPrestamosClicked" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Pagos"
                        Clicked="OnPagosClicked" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="Morosidad"
                        Clicked="OnMorosidadClicked" />

                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
