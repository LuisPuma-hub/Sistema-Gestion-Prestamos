<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.NotificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            BackgroundColor="#15307A"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="16,48,16,20">
            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                <Grid
                    Grid.Column="0"
                    HeightRequest="44"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Image
                        Source="ic_chev_l_w.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    Text="Notificaciones"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Column="2"
                    WidthRequest="44"
                    BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Label
                    Text="REGLAS PROGRAMADAS"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="#6B7280"
                    CharacterSpacing="1" />

                <CollectionView
                    x:Name="ReglasCollection"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="14,12"
                                Margin="0,0,0,10"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnReglaTapped"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="44"
                                        WidthRequest="44"
                                        BackgroundColor="#DBEAFE"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        VerticalOptions="Center">
                                        <Image
                                            Source="ic_bell.png"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Nombre}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#111827" />
                                        <Label
                                            Text="{Binding Hora}"
                                            FontSize="13"
                                            TextColor="#6B7280" />
                                    </VerticalStackLayout>
                                    <Switch
                                        Grid.Column="2"
                                        IsToggled="{Binding Activa}"
                                        OnColor="#15307A"
                                        VerticalOptions="Center"
                                        Toggled="OnActivaToggled" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    x:Name="HistorialButton"
                    Text="Ver historial de envíos"
                    BackgroundColor="#DBEAFE"
                    TextColor="#1E3A8A"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnHistorialClicked" />

                <Label
                    x:Name="EstadoLabel"
                    IsVisible="False"
                    TextColor="#6B7280"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="16,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <BoxView Grid.Column="0" BackgroundColor="Transparent" />
            <Border
                Grid.Column="1"
                BackgroundColor="#15307A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30"
                HeightRequest="60"
                WidthRequest="60">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNuevaReglaClicked" />
                </Border.GestureRecognizers>
                <Image Source="ic_plus_w.png" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

    </Grid>

</ContentPage>
