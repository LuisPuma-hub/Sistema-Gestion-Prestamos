<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.UsuariosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Usuarios">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="16"
        RowSpacing="12">

        <Label
            Grid.Row="0"
            x:Name="ResumenLabel"
            Text="Usuarios: 0"
            FontAttributes="Bold" />

        <CollectionView
            Grid.Row="1"
            x:Name="UsuariosCollection"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="14"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnUsuarioTapped"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding NombreCompleto}"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label
                                Text="{Binding Email}"
                                FontSize="14" />
                            <Label
                                Text="{Binding Rol, StringFormat='Rol: {0}'}"
                                FontSize="14"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
            <Button
                Grid.Column="0"
                x:Name="ReintentarButton"
                Text="Reintentar"
                IsVisible="False"
                Clicked="OnReintentarClicked" />
            <Button
                Grid.Column="1"
                Text="+"
                FontSize="24"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                Clicked="OnNuevoUsuarioClicked" />
        </Grid>

        <ActivityIndicator
            Grid.Row="1"
            x:Name="CargandoIndicator"
            IsVisible="False"
            IsRunning="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            Grid.Row="1"
            x:Name="EstadoLabel"
            IsVisible="False"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

    </Grid>

</ContentPage>
