<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.ClientesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SistemaPrestamos.Mobile.Views"
    Title=""
    BackgroundColor="#F8F7FC">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Border
                BackgroundColor="#15307A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,28,28"
                Padding="24,48,24,20">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="Clientes"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        HeightRequest="36"
                        WidthRequest="36"
                        BackgroundColor="#3B82F6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        VerticalOptions="Center">
                        <Label
                            x:Name="ResumenLabel"
                            Text="0"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="16,12,16,4" Spacing="10">
                <Border
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E5E7EB"
                    BackgroundColor="White"
                    Padding="12,2">
                    <HorizontalStackLayout Spacing="8">
                        <SearchBar
                            x:Name="BuscarBar"
                            Placeholder="Buscar cliente, DNI..."
                            BackgroundColor="Transparent"
                            HorizontalOptions="Fill"
                            TextChanged="OnBuscarTextChanged" />
                    </HorizontalStackLayout>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="ChipsLayout" Spacing="8">
                        <Button x:Name="ChipTodos" Text="Todos" Clicked="OnFiltroChipClicked" />
                        <Button x:Name="ChipActivo" Text="Activo" Clicked="OnFiltroChipClicked" />
                        <Button x:Name="ChipObservacion" Text="En observación" Clicked="OnFiltroChipClicked" />
                        <Button x:Name="ChipMoroso" Text="Moroso" Clicked="OnFiltroChipClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="1" Padding="16,4,16,0">
            <CollectionView
                x:Name="ClientesCollection"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="14,12"
                            Margin="0,0,0,10"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnClienteTapped"
                                    CommandParameter="{Binding Id}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    Grid.Column="0"
                                    HeightRequest="52"
                                    WidthRequest="52"
                                    BackgroundColor="#DBEAFE"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 26"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Inicial}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="#15307A"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label
                                        Text="{Binding NombreCompleto}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#111827" />
                                    <Label
                                        Text="{Binding NumeroDocumento}"
                                        FontSize="13"
                                        TextColor="#6B7280" />
                                    <Label
                                        Text="{Binding Telefono}"
                                        FontSize="13"
                                        TextColor="#6B7280" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    Padding="10,6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Start"
                                    BackgroundColor="{Binding Estado, Converter={StaticResource EstadoFondo}}">
                                    <Label
                                        Text="{Binding Estado}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{Binding Estado, Converter={StaticResource EstadoTexto}}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="#15307A"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="EstadoLabel"
                IsVisible="False"
                TextColor="#6B7280"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Padding="16,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button
                Grid.Column="0"
                x:Name="ReintentarButton"
                Text="Reintentar"
                BackgroundColor="#15307A"
                TextColor="White"
                CornerRadius="12"
                IsVisible="False"
                Clicked="OnReintentarClicked" />
            <Border
                Grid.Column="1"
                BackgroundColor="#15307A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30"
                HeightRequest="60"
                WidthRequest="60">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNuevoClienteClicked" />
                </Border.GestureRecognizers>
                <Image Source="ic_plus_w.png" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <views:BarraTabs Grid.Row="3" TabActual="Clientes" />

    </Grid>

</ContentPage>
