<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.ImportacionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            BackgroundColor="#15307A"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="16,48,16,20">
            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                <Grid
                    Grid.Column="0"
                    HeightRequest="44"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Image
                        Source="ic_chev_l_w.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    Text="Importar préstamos"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Column="2"
                    WidthRequest="44"
                    BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12" Spacing="12">

                <Border
                    Padding="14,12"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Archivo CSV"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#111827" />
                        <Label
                            x:Name="ArchivoLabel"
                            Text="Ningún archivo elegido."
                            FontSize="13"
                            TextColor="#6B7280" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Text="Elegir CSV"
                                BackgroundColor="#15307A"
                                TextColor="White"
                                CornerRadius="12"
                                Clicked="OnElegirClicked" />
                            <Button
                                Grid.Column="1"
                                Text="Plantilla"
                                BackgroundColor="#E5E7EB"
                                TextColor="#111827"
                                CornerRadius="12"
                                Clicked="OnPlantillaClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="PrevisualizarButton"
                    Text="Previsualizar"
                    BackgroundColor="#15307A"
                    TextColor="White"
                    CornerRadius="12"
                    IsEnabled="False"
                    Clicked="OnPrevisualizarClicked" />

                <Border
                    x:Name="ResumenCard"
                    Padding="14,12"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    IsVisible="False">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            x:Name="ResumenLabel"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#111827" />
                        <Label
                            Text="Revise fila por fila antes de confirmar."
                            FontSize="13"
                            TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Border>

                <CollectionView
                    x:Name="FilasCollection"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="14,12"
                                Margin="0,0,0,10"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        Text="{Binding Titulo}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#111827" />
                                    <Label
                                        Text="{Binding Detalle}"
                                        FontSize="13"
                                        TextColor="#6B7280" />
                                    <Label
                                        Text="Válida"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#15803D"
                                        IsVisible="{Binding Valida}" />
                                    <Label
                                        Text="Con error"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="#DC2626"
                                        IsVisible="{Binding ConError}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator
                    x:Name="CargandoIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#15307A"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="EstadoLabel"
                    IsVisible="False"
                    TextColor="#6B7280"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="16,8">
            <Button
                x:Name="ConfirmarButton"
                Text="Confirmar importación"
                BackgroundColor="#15803D"
                TextColor="White"
                CornerRadius="12"
                IsVisible="False"
                Clicked="OnConfirmarClicked" />
        </Grid>

    </Grid>

</ContentPage>
