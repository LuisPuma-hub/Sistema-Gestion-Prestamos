<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.MorosidadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Morosidad">

    <Grid
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        Padding="16"
        RowSpacing="12">

        <Picker
            Grid.Row="0"
            x:Name="FiltroPicker"
            Title="Mostrar"
            SelectedIndexChanged="OnFiltroChanged">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Solo morosos</x:String>
                    <x:String>Todos los activos</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Button
            Grid.Row="1"
            x:Name="EvaluarButton"
            Text="Evaluar morosidad"
            Clicked="OnEvaluarClicked" />

        <Label
            Grid.Row="2"
            x:Name="ResumenLabel"
            Text="Préstamos en mora: 0"
            FontAttributes="Bold" />

        <CollectionView
            Grid.Row="3"
            x:Name="MorosidadCollection"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="14"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnMorosidadTapped"
                                CommandParameter="{Binding PrestamoId}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding PrestamoNombre}"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label
                                Text="{Binding PagosInteresVencidos, StringFormat='Semanas vencidas: {0}'}"
                                FontSize="14" />
                            <Label
                                Text="{Binding Activa, StringFormat='Mora activa: {0}'}"
                                FontSize="14"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="4"
            x:Name="ReintentarButton"
            Text="Reintentar"
            IsVisible="False"
            Clicked="OnEvaluarClicked" />

        <ActivityIndicator
            Grid.Row="3"
            x:Name="CargandoIndicator"
            IsVisible="False"
            IsRunning="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            Grid.Row="3"
            x:Name="EstadoLabel"
            IsVisible="False"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

    </Grid>

</ContentPage>
