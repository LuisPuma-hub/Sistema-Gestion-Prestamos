<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.ReportesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            Grid.Row="0"
            BackgroundColor="#15307A"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="16,48,16,20">
            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                <Grid
                    Grid.Column="0"
                    HeightRequest="44"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Image
                        Source="ic_chev_l_w.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    Text="Reportes"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Column="2"
                    WidthRequest="44"
                    BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12" Spacing="12">

                <Border Padding="14,12" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="COBRADO HOY" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Label x:Name="CobradoLabel" Text="S/ 0.00" FontSize="28" FontAttributes="Bold" TextColor="#16A34A" />
                        <Label x:Name="CobradoDetalleLabel" Text="" FontSize="13" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14,12" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CARTERA POR COBRAR" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Label x:Name="CarteraLabel" Text="S/ 0.00" FontSize="28" FontAttributes="Bold" TextColor="#15307A" />
                        <Label x:Name="CarteraDetalleLabel" Text="" FontSize="13" TextColor="#6B7280" />
                        <Button
                            Text="Exportar CSV"
                            BackgroundColor="#E5E7EB"
                            TextColor="#111827"
                            CornerRadius="12"
                            Clicked="OnExportarClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14,12" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="CAPITAL" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Label x:Name="DisponibleLabel" Text="S/ 0.00" FontSize="28" FontAttributes="Bold" TextColor="#15307A" />
                        <Label x:Name="CapitalDetalleLabel" Text="" FontSize="13" TextColor="#6B7280" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Text="+ Aporte"
                                BackgroundColor="#DCFCE7"
                                TextColor="#166534"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                Clicked="OnAporteClicked" />
                            <Button
                                Grid.Column="1"
                                Text="− Retiro"
                                BackgroundColor="#FEE2E2"
                                TextColor="#991B1B"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                Clicked="OnRetiroClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="INGRESOS ÚLTIMOS 7 DÍAS" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />

                <CollectionView
                    x:Name="IngresosCollection"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="14,12"
                                Margin="0,0,0,10"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Dia}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#111827" />
                                        <Label
                                            Text="{Binding NumPagos, StringFormat='{0} pago(s)'}"
                                            FontSize="13"
                                            TextColor="#6B7280" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Total, StringFormat='S/ {0:N2}'}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#16A34A"
                                            HorizontalTextAlignment="End" />
                                        <Label
                                            Text="{Binding Intereses, StringFormat='Int. S/ {0:N2}'}"
                                            FontSize="12"
                                            TextColor="#6B7280"
                                            HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator
                    x:Name="CargandoIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#15307A"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="EstadoLabel"
                    IsVisible="False"
                    TextColor="#6B7280"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="16,8">
            <Button
                x:Name="ReintentarButton"
                Text="Reintentar"
                BackgroundColor="#15307A"
                TextColor="White"
                CornerRadius="12"
                IsVisible="False"
                Clicked="OnReintentarClicked" />
        </Grid>

    </Grid>

</ContentPage>
