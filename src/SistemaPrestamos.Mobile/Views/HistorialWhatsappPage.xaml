<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.HistorialWhatsappPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Historial WhatsApp">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="16"
        RowSpacing="12">

        <Label
            Grid.Row="0"
            x:Name="ClienteLabel"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />

        <CollectionView
            Grid.Row="1"
            x:Name="HistorialCollection"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="14"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding TipoPlantilla}"
                                FontSize="13"
                                FontAttributes="Bold" />
                            <Label
                                Text="{Binding Contenido}"
                                FontSize="15" />
                            <Label
                                Text="{Binding FechaCreacion, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                FontSize="12" />
                            <Label
                                Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="8">
            <Button
                x:Name="RecordatorioButton"
                Text="Enviar recordatorio"
                Clicked="OnRecordatorioClicked" />
            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <ActivityIndicator
            Grid.Row="1"
            x:Name="CargandoIndicator"
            IsVisible="False"
            IsRunning="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            Grid.Row="1"
            x:Name="EstadoLabel"
            IsVisible="False"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center" />

    </Grid>

</ContentPage>
