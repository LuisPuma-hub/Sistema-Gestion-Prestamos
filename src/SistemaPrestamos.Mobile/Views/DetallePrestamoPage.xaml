<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.DetallePrestamoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border
                BackgroundColor="#512BD4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,28,28"
                Padding="16,48,16,20">
                <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                    <Grid
                        Grid.Column="0"
                        HeightRequest="44"
                        WidthRequest="44"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVolverClicked" />
                        </Grid.GestureRecognizers>
                        <Image
                            Source="ic_chev_l_w.png"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                    <Label
                        Grid.Column="1"
                        Text="Detalle de préstamo"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center" />
                    <BoxView
                        Grid.Column="2"
                        WidthRequest="44"
                        BackgroundColor="Transparent" />
                </Grid>
            </Border>

            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            HeightRequest="56" WidthRequest="56"
                            BackgroundColor="#EDE9FE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            VerticalOptions="Center">
                            <Label
                                x:Name="AvatarLabel"
                                Text="M"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#512BD4"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="ClienteLabel" FontSize="19" FontAttributes="Bold" TextColor="#111827" />
                            <Label x:Name="DocumentoLabel" FontSize="13" TextColor="#6B7280" />
                                <Border
                                    x:Name="EstadoPill"
                                    Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{Binding Estado, Converter={StaticResource EstadoFondo}}">
                                <Label
                                    x:Name="EstadoLabel2"
                                    Text=""
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{Binding Estado, Converter={StaticResource EstadoTexto}}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="RESUMEN FINANCIERO" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0" Padding="12,10" BackgroundColor="#F8F7FC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Capital inicial" FontSize="12" TextColor="#6B7280" />
                                <Label x:Name="CapitalLabel" FontSize="17" FontAttributes="Bold" TextColor="#111827" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Padding="12,10" BackgroundColor="#F8F7FC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Capital pendiente" FontSize="12" TextColor="#6B7280" />
                                <Label x:Name="PendienteLabel" FontSize="17" FontAttributes="Bold" TextColor="#DC2626" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Padding="12,10" BackgroundColor="#F8F7FC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Interés semanal" FontSize="12" TextColor="#6B7280" />
                                <Label x:Name="InteresLabel" FontSize="17" FontAttributes="Bold" TextColor="#D97706" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Padding="12,10" BackgroundColor="#F8F7FC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Tasa" FontSize="12" TextColor="#6B7280" />
                                <Label x:Name="TasaLabel" FontSize="17" FontAttributes="Bold" TextColor="#512BD4" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Padding="12,10" BackgroundColor="#F8F7FC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Fecha inicio" FontSize="12" TextColor="#6B7280" />
                                <Label x:Name="FechaInicioLabel" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Padding="12,10" BackgroundColor="#F8F7FC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Próx. venc." FontSize="12" TextColor="#6B7280" />
                                <Label x:Name="ProxVencLabel" Text="-" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Label Text="HISTORIAL DE PAGOS" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="PagosResumenLabel" Text="Sin pagos registrados." FontSize="14" TextColor="#6B7280" IsVisible="False" />
                        <CollectionView x:Name="PagosCollection" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPagoTapped" CommandParameter="{Binding Id}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                                            <Label Text="{Binding Monto, StringFormat='S/ {0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                            <Label Text="{Binding FechaPago, StringFormat='{0:dd/MM/yyyy}'}" FontSize="13" TextColor="#6B7280" />
                                            <Label Text="{Binding MontoInteres, StringFormat='Int. S/ {0:N2}'}" FontSize="12" TextColor="#6B7280" />
                                            <Label Text="{Binding MontoCapital, StringFormat='Cap. S/ {0:N2}'}" FontSize="12" TextColor="#6B7280" />
                                        </VerticalStackLayout>
                                        <Image Grid.Column="1" Source="ic_chev_r.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <BoxView HeightRequest="1" Color="#F3F4F6" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total pagado" FontSize="15" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="TotalPagadoLabel" Text="S/ 0.00" FontSize="16" FontAttributes="Bold" TextColor="#16A34A" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button
                    x:Name="AprobarButton"
                    Text="Aprobar préstamo"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54"
                    IsVisible="False"
                    Clicked="OnAprobarClicked" />

                <Button
                    x:Name="PagarButton"
                    Text="$  Registrar pago"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54"
                    Clicked="OnPagarClicked" />

                <Button
                    x:Name="MorosidadButton"
                    Text="Ver morosidad"
                    BackgroundColor="#EDE9FE"
                    TextColor="#512BD4"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="OnMorosidadClicked" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button
                        Grid.Column="0"
                        x:Name="WhatsappButton"
                        Text="💬 WhatsApp"
                        BackgroundColor="#16A34A"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        Clicked="OnWhatsappClicked" />
                    <Button
                        Grid.Column="1"
                        x:Name="AnularButton"
                        Text="Anular"
                        BackgroundColor="#FEE2E2"
                        TextColor="#DC2626"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        IsVisible="False"
                        Clicked="OnAnularClicked" />
                </Grid>

                <ActivityIndicator
                    x:Name="CargandoIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#512BD4"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="#DC2626"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
