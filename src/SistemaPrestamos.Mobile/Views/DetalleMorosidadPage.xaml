<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.DetalleMorosidadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border
                BackgroundColor="#512BD4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,28,28"
                Padding="16,48,16,20">
                <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                    <Grid
                        Grid.Column="0"
                        HeightRequest="44"
                        WidthRequest="44"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVolverClicked" />
                        </Grid.GestureRecognizers>
                        <Image
                            Source="ic_chev_l_w.png"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                    <Label
                        Grid.Column="1"
                        Text="Detalle de mora"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center" />
                    <BoxView
                        Grid.Column="2"
                        WidthRequest="44"
                        BackgroundColor="Transparent" />
                </Grid>
            </Border>

            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="ClienteLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" HorizontalTextAlignment="Center" />
                        <Label x:Name="EstadoLabel2" FontSize="15" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="MOROSIDAD" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Semanas vencidas" FontSize="15" TextColor="#111827" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="SemanasLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#DC2626" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F3F4F6" />
                        <Label x:Name="InicioLabel" FontSize="14" TextColor="#6B7280" />
                        <Label x:Name="ReactivacionLabel" FontSize="14" TextColor="#6B7280" />
                        <Label x:Name="ObservacionesLabel" FontSize="14" TextColor="#111827" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="REACTIVAR CLIENTE (SOLO ADMIN)" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" Padding="12,4">
                            <Editor
                                x:Name="ObservacionesEditor"
                                Placeholder="Motivo de reactivación..."
                                AutoSize="TextChanges" />
                        </Border>
                        <Button
                            x:Name="ReactivarButton"
                            Text="✓  Reactivar cliente"
                            BackgroundColor="#16A34A"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="54"
                            Clicked="OnReactivarClicked" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator
                    x:Name="CargandoIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#512BD4"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="#DC2626"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
