<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SistemaPrestamos.Mobile.Views.BarraTabs"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White">

    <Grid
        ColumnDefinitions="*,*,*,*,*,*"
        Padding="4,8,4,4">

        <VerticalStackLayout
            Grid.Column="0"
            Spacing="0"
            x:Name="TabInicio">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="MainPage" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconoInicio" Text="⌂" FontSize="22" HorizontalTextAlignment="Center" />
            <Label x:Name="TextoInicio" Text="Inicio" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Column="1"
            Spacing="0"
            x:Name="TabClientes">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Clientes" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconoClientes" Text="◉" FontSize="22" HorizontalTextAlignment="Center" />
            <Label x:Name="TextoClientes" Text="Clientes" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Column="2"
            Spacing="0"
            x:Name="TabPrestamos">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Prestamos" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconoPrestamos" Text="▤" FontSize="22" HorizontalTextAlignment="Center" />
            <Label x:Name="TextoPrestamos" Text="Préstamos" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Column="3"
            Spacing="0"
            x:Name="TabPagos">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Pagos" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconoPagos" Text="$" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label x:Name="TextoPagos" Text="Pagos" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Column="4"
            Spacing="0"
            x:Name="TabMora">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Morosidad" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconoMora" Text="!" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label x:Name="TextoMora" Text="Mora" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Column="5"
            Spacing="0"
            x:Name="TabMas">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Mas" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconoMas" Text="•••" FontSize="22" HorizontalTextAlignment="Center" />
            <Label x:Name="TextoMas" Text="Más" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

    </Grid>

</ContentView>
