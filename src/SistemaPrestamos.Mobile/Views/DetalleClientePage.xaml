<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.DetalleClientePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <Border
                    BackgroundColor="#1D4ED8"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,28,28"
                    Padding="16,48,16,24">
                    <Grid ColumnDefinitions="44,*,Auto" VerticalOptions="Center">
                        <Grid
                            Grid.Column="0"
                            HeightRequest="44"
                            WidthRequest="44"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVolverClicked" />
                            </Grid.GestureRecognizers>
                            <Image
                                Source="ic_chev_l_w.png"
                                WidthRequest="24"
                                HeightRequest="24"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Grid>
                        <Label
                            Grid.Column="1"
                            Text="Detalle de cliente"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="2"
                            x:Name="EditarButton"
                            Text="Editar"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#3B82F6"
                            CornerRadius="10"
                            Padding="16,8"
                            VerticalOptions="Center"
                            Clicked="OnEditarClicked" />
                    </Grid>
                </Border>

                <VerticalStackLayout Padding="16" Spacing="14">

                    <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border
                                Grid.Column="0"
                                HeightRequest="64" WidthRequest="64"
                                BackgroundColor="#DBEAFE"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 32"
                                VerticalOptions="Center">
                                <Label
                                    x:Name="AvatarLabel"
                                    Text="M"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="#1D4ED8"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="NombreLabel" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                                <Label x:Name="DocumentoLabel" FontSize="13" TextColor="#6B7280" />
                                <Border
                                    x:Name="EstadoPill"
                                    Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{Binding Estado, Converter={StaticResource EstadoFondo}}">
                                    <Label
                                        x:Name="EstadoLabel"
                                        Text=""
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{Binding Estado, Converter={StaticResource EstadoTexto}}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Label Text="DATOS PERSONALES" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                    <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="2">
                            <Picker x:Name="TipoDocumentoPicker" Title="Tipo de documento" IsEnabled="False" IsVisible="False">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>DNI</x:String>
                                        <x:String>CE</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <Entry x:Name="NumeroDocumentoEntry" IsVisible="False" IsEnabled="False" />
                            <Label Text="Teléfono" FontSize="13" TextColor="#6B7280" />
                            <Entry x:Name="TelefonoEntry" Keyboard="Telephone" IsEnabled="False" FontSize="16" TextColor="#111827" />
                            <BoxView HeightRequest="1" Color="#F3F4F6" />
                            <Label Text="Dirección" FontSize="13" TextColor="#6B7280" />
                            <Entry x:Name="DireccionEntry" IsEnabled="False" FontSize="16" TextColor="#111827" />
                            <BoxView HeightRequest="1" Color="#F3F4F6" />
                            <Label Text="Referencia" FontSize="13" TextColor="#6B7280" />
                            <Entry x:Name="ReferenciaEntry" IsEnabled="False" FontSize="16" TextColor="#111827" />
                            <Entry x:Name="NombresEntry" IsVisible="False" IsEnabled="False" />
                            <Entry x:Name="ApellidosEntry" IsVisible="False" IsEnabled="False" />
                            <Editor x:Name="ObservacionesEditor" Placeholder="Observaciones" AutoSize="TextChanges" IsEnabled="False" FontSize="14" />
                            <Label x:Name="FechaLabel" FontSize="12" TextColor="#9CA3AF" />
                            <Button
                                x:Name="GuardarButton"
                                Text="Guardar cambios"
                                BackgroundColor="#1D4ED8"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                IsVisible="False"
                                Clicked="OnGuardarClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="RECIBO DE DOMICILIO" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                    <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Grid
                                x:Name="FotoPlaceholder"
                                HeightRequest="120"
                                BackgroundColor="#F3F4F6">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="ic_image.png" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Label Text="Sin foto" FontSize="13" TextColor="#9CA3AF" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFotoTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <Image
                                x:Name="FotoImage"
                                HeightRequest="180"
                                Aspect="AspectFill"
                                IsVisible="False">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFotoTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Label x:Name="FotoLabel" Text="Sin foto registrada." FontSize="13" TextColor="#6B7280" IsVisible="False" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button
                                    Grid.Column="0"
                                    x:Name="CamaraButton"
                                    Text="◉ Cámara"
                                    BackgroundColor="#DBEAFE"
                                    TextColor="#1D4ED8"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    Clicked="OnCamaraClicked" />
                                <Button
                                    Grid.Column="1"
                                    x:Name="GaleriaButton"
                                    Text="Galería"
                                    BackgroundColor="#F3F4F6"
                                    TextColor="#374151"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    Clicked="OnGaleriaClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="AVAL" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                    <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                    <Label x:Name="GaranteLabel" Text="Sin aval registrado." FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                    <Label x:Name="GaranteDetalleLabel" Text="" FontSize="13" TextColor="#6B7280" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    x:Name="QuitarAvalButton"
                                    Text="Quitar"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#DC2626"
                                    BackgroundColor="#FEE2E2"
                                    CornerRadius="10"
                                    Padding="12,6"
                                    VerticalOptions="Center"
                                    IsVisible="False"
                                    Clicked="OnQuitarAvalClicked" />
                            </Grid>

                            <Border x:Name="OpcionSinAvalD" Padding="14,12" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvalOpcionTapped" CommandParameter="Sin aval" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="10">
                                    <Border x:Name="RadioSinAvalD" HeightRequest="22" WidthRequest="22" StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                                        <BoxView x:Name="RadioSinAvalDotD" HeightRequest="12" WidthRequest="12" CornerRadius="6" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" Color="#1D4ED8" />
                                    </Border>
                                    <Label Text="Sin aval" FontSize="15" TextColor="#111827" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border x:Name="OpcionExistenteD" Padding="14,12" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvalOpcionTapped" CommandParameter="Cliente existente" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="10">
                                    <Border x:Name="RadioExistenteD" HeightRequest="22" WidthRequest="22" StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                                        <BoxView x:Name="RadioExistenteDotD" HeightRequest="12" WidthRequest="12" CornerRadius="6" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" Color="#1D4ED8" />
                                    </Border>
                                    <Label Text="Cliente existente" FontSize="15" TextColor="#111827" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border x:Name="OpcionNuevoD" Padding="14,12" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvalOpcionTapped" CommandParameter="Nuevo aval" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="10">
                                    <Border x:Name="RadioNuevoD" HeightRequest="22" WidthRequest="22" StrokeShape="RoundRectangle 11" VerticalOptions="Center">
                                        <BoxView x:Name="RadioNuevoDotD" HeightRequest="12" WidthRequest="12" CornerRadius="6" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" Color="#1D4ED8" />
                                    </Border>
                                    <Label Text="Nuevo aval" FontSize="15" TextColor="#111827" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Picker
                                x:Name="AvalClientePicker"
                                Title="Seleccione cliente como aval"
                                ItemDisplayBinding="{Binding NombreCompleto}"
                                IsVisible="False" />

                            <VerticalStackLayout x:Name="AvalNuevoLayout" Spacing="8" IsVisible="False">
                                <Entry x:Name="AvalNombresEntry" Placeholder="Nombres del aval" />
                                <Entry x:Name="AvalApellidosEntry" Placeholder="Apellidos del aval" />
                                <Entry x:Name="AvalTelefonoEntry" Placeholder="Teléfono del aval" Keyboard="Telephone" />
                                <Entry x:Name="AvalDireccionEntry" Placeholder="Dirección del aval (opcional)" />
                            </VerticalStackLayout>

                            <Button
                                x:Name="GuardarAvalButton"
                                Text="Guardar aval"
                                BackgroundColor="#1D4ED8"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                IsVisible="False"
                                Clicked="OnGuardarAvalClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="PRÉSTAMOS DEL CLIENTE" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                    <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="PrestamosResumenLabel" Text="Sin préstamos registrados." FontSize="14" TextColor="#6B7280" />
                            <CollectionView x:Name="PrestamosCollection" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPrestamoTapped" CommandParameter="{Binding Id}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                <Label Text="{Binding CapitalInicial, StringFormat='S/ {0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                                <Label Text="{Binding CapitalPendiente, StringFormat='Pend. S/ {0:N2}'}" FontSize="13" TextColor="#6B7280" />
                                                <Label Text="{Binding FechaInicio, StringFormat='{0:dd/MM/yyyy}'}" FontSize="13" TextColor="#6B7280" />
                                            </VerticalStackLayout>
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,4"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                VerticalOptions="Center"
                                                BackgroundColor="{Binding Estado, Converter={StaticResource EstadoFondo}}">
                                                <Label
                                                    Text="{Binding Estado}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding Estado, Converter={StaticResource EstadoTexto}}" />
                                            </Border>
                                            <Image Grid.Column="2" Source="ic_chev_r.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="CAMBIAR ESTADO" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                    <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Picker x:Name="EstadoPicker" Title="Estado">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Activo</x:String>
                                        <x:String>En observación</x:String>
                                        <x:String>Moroso</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <Button
                                x:Name="CambiarEstadoButton"
                                Text="Guardar estado"
                                BackgroundColor="#1D4ED8"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                Clicked="OnCambiarEstadoClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            x:Name="WhatsappButton"
                            Text="💬 WhatsApp"
                            BackgroundColor="#16A34A"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="52"
                            Clicked="OnWhatsappClicked" />
                        <Button
                            Grid.Column="1"
                            x:Name="EliminarButton"
                            Text="🗑 Eliminar"
                            BackgroundColor="#FEE2E2"
                            TextColor="#DC2626"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="52"
                            IsVisible="False"
                            Clicked="OnEliminarClicked" />
                    </Grid>

                    <ActivityIndicator
                        x:Name="CargandoIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="#1D4ED8"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="ErrorLabel"
                        TextColor="#DC2626"
                        IsVisible="False"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            x:Name="FotoOverlay"
            BackgroundColor="#CC000000"
            IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCerrarFoto" />
            </Grid.GestureRecognizers>
            <Border
                Margin="24"
                Padding="0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <Grid>
                    <Image x:Name="FotoCompletaImage" Aspect="AspectFit" HeightRequest="500" />
                    <Button
                        Text="X"
                        FontAttributes="Bold"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="8"
                        Clicked="OnCerrarFoto" />
                </Grid>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
