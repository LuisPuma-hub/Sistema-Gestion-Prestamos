<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.DetallePagoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del pago">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="14">

            <Label
                x:Name="MontoLabel"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="FechaLabel"
                FontSize="15"
                HorizontalTextAlignment="Center" />

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Distribución"
                        FontAttributes="Bold" />
                    <Label x:Name="InteresLabel" FontSize="15" />
                    <Label x:Name="CapitalLabel" FontSize="15" />
                    <Label x:Name="PendienteLabel" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Adicional"
                        FontAttributes="Bold" />
                    <Label x:Name="ComprobanteLabel" FontSize="14" />
                    <Label x:Name="ObservacionesLabel" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
