<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.PrestamosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SistemaPrestamos.Mobile.Views"
    Title=""
    BackgroundColor="#F8F7FC">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Border
                BackgroundColor="#512BD4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,28,28"
                Padding="24,48,24,20">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="Préstamos"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        HeightRequest="36"
                        WidthRequest="36"
                        BackgroundColor="#6D4DE0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        VerticalOptions="Center">
                        <Label
                            x:Name="ResumenLabel"
                            Text="0"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="16,12,16,4" Spacing="10">
                <Border
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E5E7EB"
                    BackgroundColor="White"
                    Padding="12,2">
                    <HorizontalStackLayout Spacing="8">
                        <Label
                            Text="🔍"
                            FontSize="16"
                            TextColor="#9CA3AF"
                            VerticalOptions="Center" />
                        <SearchBar
                            x:Name="BuscarBar"
                            Placeholder="Buscar por cliente..."
                            BackgroundColor="Transparent"
                            HorizontalOptions="Fill"
                            TextChanged="OnBuscarTextChanged" />
                    </HorizontalStackLayout>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="ChipTodos" Text="Todos" Clicked="OnFiltroChipClicked" />
                        <Button x:Name="ChipPendiente" Text="Pendiente" Clicked="OnFiltroChipClicked" />
                        <Button x:Name="ChipActivo" Text="Activo" Clicked="OnFiltroChipClicked" />
                        <Button x:Name="ChipCancelado" Text="Cancelado" Clicked="OnFiltroChipClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="1" Padding="16,4,16,0">
            <CollectionView
                x:Name="PrestamosCollection"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16,14"
                            Margin="0,0,0,10"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnPrestamoTapped"
                                    CommandParameter="{Binding Id}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Label
                                    Grid.Row="0" Grid.Column="0"
                                    Text="{Binding ClienteNombre}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />
                                <Border
                                    Grid.Row="0" Grid.Column="1"
                                    Padding="10,4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Start"
                                    BackgroundColor="{Binding Estado, Converter={StaticResource EstadoFondo}}">
                                    <Label
                                        Text="{Binding Estado}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{Binding Estado, Converter={StaticResource EstadoTexto}}" />
                                </Border>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="0">
                                    <Label Text="Capital" FontSize="12" TextColor="#9CA3AF" />
                                    <Label Text="{Binding CapitalInicial, StringFormat='S/ {0:N2}'}" FontSize="17" FontAttributes="Bold" TextColor="#111827" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                    <Label Text="Pendiente" FontSize="12" TextColor="#9CA3AF" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding CapitalPendiente, StringFormat='S/ {0:N2}'}" FontSize="17" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                    <Label Text="◉" FontSize="12" TextColor="#D97706" VerticalOptions="Center" />
                                    <Label Text="{Binding InteresSemanal, StringFormat='Interés semanal 5%: S/ {0:N2}/sem.'}" FontSize="13" TextColor="#6B7280" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="#512BD4"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="EstadoLabel"
                IsVisible="False"
                TextColor="#6B7280"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Padding="16,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button
                Grid.Column="0"
                x:Name="ReintentarButton"
                Text="Reintentar"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="12"
                IsVisible="False"
                Clicked="OnReintentarClicked" />
            <Button
                Grid.Column="1"
                Text="+"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#512BD4"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                Clicked="OnNuevoPrestamoClicked" />
        </Grid>

        <views:BarraTabs Grid.Row="3" TabActual="Prestamos" />

    </Grid>

</ContentPage>
