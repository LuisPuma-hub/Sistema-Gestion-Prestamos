<?xml version="1.0" encoding="utf-8" ?>

<Shell
    x:Class="SistemaPrestamos.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SistemaPrestamos.Mobile"
    xmlns:views="clr-namespace:SistemaPrestamos.Mobile.Views"
    Title="Sistema de Préstamos"
    FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarTitleColor="#6B7280"
    Shell.TabBarUnselectedColor="#9CA3AF"
    Shell.TabBarForegroundColor="#512BD4">

    <TabBar Route="Tabs">
        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Clientes"
            ContentTemplate="{DataTemplate views:ClientesPage}"
            Route="Clientes" />

        <ShellContent
            Title="Préstamos"
            ContentTemplate="{DataTemplate views:PrestamosPage}"
            Route="Prestamos" />

        <ShellContent
            Title="Pagos"
            ContentTemplate="{DataTemplate views:PagosPage}"
            Route="Pagos" />

        <ShellContent
            Title="Mora"
            ContentTemplate="{DataTemplate views:MorosidadPage}"
            Route="Morosidad" />

        <ShellContent
            Title="Más"
            ContentTemplate="{DataTemplate views:MasPage}"
            Route="Mas" />
    </TabBar>

</Shell>
