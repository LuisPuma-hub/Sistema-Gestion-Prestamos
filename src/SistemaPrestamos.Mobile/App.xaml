<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SistemaPrestamos.Mobile"
             xmlns:conv="clr-namespace:SistemaPrestamos.Mobile.Converters"
             x:Class="SistemaPrestamos.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EstadoFondoConverter x:Key="EstadoFondo" />
            <conv:EstadoTextoConverter x:Key="EstadoTexto" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
