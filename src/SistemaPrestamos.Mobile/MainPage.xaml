<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SistemaPrestamos.Mobile.MainPage"
    Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Label
                Text="Dashboard"
                FontSize="32"
                FontAttributes="Bold" />

            <Label
                Text="Sistema de Gestión de Préstamos"
                FontSize="18" />

            <Border
                Padding="20"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="Bienvenido"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Label
                        Text="Has iniciado sesión correctamente."
                        FontSize="16" />

                </VerticalStackLayout>

            </Border>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Clientes" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="Préstamos" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Pagos" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="Morosidad" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
