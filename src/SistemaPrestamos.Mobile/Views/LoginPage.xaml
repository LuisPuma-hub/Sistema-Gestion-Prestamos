<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC">

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            BackgroundColor="#512BD4"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="24,48,24,32">
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border
                        HeightRequest="44"
                        WidthRequest="44"
                        BackgroundColor="#6D4DE0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Center">
                        <Label
                            Text="▤"
                            FontSize="22"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label
                            Text="PréstamosPE"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            Text="SISTEMA DE PRÉSTAMOS"
                            FontSize="10"
                            TextColor="#C4B5FD"
                            CharacterSpacing="1" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Label
                    Text="Bienvenido"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="White"
                    Margin="0,16,0,0" />

                <Label
                    Text="Ingresa con tu cuenta de cobrador"
                    FontSize="14"
                    TextColor="#DDD6FE" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="24"
                Spacing="6">

                <Label
                    Text="Correo electrónico"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Border
                    x:Name="EmailBox"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E5E7EB"
                    BackgroundColor="White"
                    Padding="12,2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmailBoxTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Entry
                            x:Name="EmailEntry"
                            Placeholder="cobrador@empresa.pe"
                            Keyboard="Email"
                            HorizontalOptions="Fill" />
                    </HorizontalStackLayout>
                </Border>

                <Label
                    Text="Contraseña"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#111827"
                    Margin="0,10,0,0" />

                <Border
                    x:Name="ClaveBox"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E5E7EB"
                    BackgroundColor="White"
                    Padding="12,2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClaveBoxTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="••••••••"
                            IsPassword="True"
                            HorizontalOptions="Fill" />
                        <Label
                            x:Name="OjoLabel"
                            Text="○"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#9CA3AF"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOjoClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <Button
                    x:Name="LoginButton"
                    Text="Ingresar"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,16,0,0"
                    Clicked="OnLoginClicked" />

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#512BD4"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="#DC2626"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="¿Olvidaste tu contraseña?"
                    FontSize="13"
                    TextColor="#512BD4"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOlvidoClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <Border
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#EDE9FE"
                    Padding="14,12"
                    Margin="0,8,0,0">
                    <HorizontalStackLayout Spacing="8">
                        <Label
                            Text="ⓘ"
                            FontSize="16"
                            TextColor="#512BD4"
                            VerticalOptions="Start" />
                        <Label FontSize="13" TextColor="#4C1D95">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Para soporte contacta a tu administrador o llama al " />
                                    <Span Text="01-234-5678" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
