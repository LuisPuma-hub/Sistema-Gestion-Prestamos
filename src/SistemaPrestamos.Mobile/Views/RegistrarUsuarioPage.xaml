<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.RegistrarUsuarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nuevo usuario">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="14">

            <Label
                Text="Nuevo usuario"
                FontSize="24"
                FontAttributes="Bold" />

            <Entry
                x:Name="NombresEntry"
                Placeholder="Nombres"
                ClearButtonVisibility="WhileEditing" />

            <Entry
                x:Name="ApellidosEntry"
                Placeholder="Apellidos"
                ClearButtonVisibility="WhileEditing" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Correo electrónico"
                Keyboard="Email"
                ClearButtonVisibility="WhileEditing" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Contraseña (mínimo 8 caracteres)"
                IsPassword="True"
                ClearButtonVisibility="WhileEditing" />

            <Picker
                x:Name="RolPicker"
                Title="Rol">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Cobrador</x:String>
                        <x:String>Administrador</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Button
                x:Name="GuardarButton"
                Text="Guardar usuario"
                Clicked="OnGuardarClicked" />

            <ActivityIndicator
                x:Name="CargandoIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
