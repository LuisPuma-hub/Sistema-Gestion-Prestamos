<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.RegistrarPagoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            BackgroundColor="#1D4ED8"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0,0,28,28"
            Padding="16,48,16,20">
            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">
                <Grid
                    Grid.Column="0"
                    HeightRequest="44"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolverClicked" />
                    </Grid.GestureRecognizers>
                    <Image
                        Source="ic_chev_l_w.png"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Column="1"
                    Text="Registrar pago"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
                <BoxView
                    Grid.Column="2"
                    WidthRequest="44"
                    BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PRÉSTAMO ACTIVO" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" Padding="12,2">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="ic_search.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Picker
                                    x:Name="PrestamoPicker"
                                    Title="María García Torres"
                                    ItemDisplayBinding="{Binding ClienteNombre}"
                                    SelectedIndexChanged="OnPrestamoChanged"
                                    HorizontalOptions="Fill" />
                            </HorizontalStackLayout>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                <Label Text="Capital pendiente" FontSize="12" TextColor="#6B7280" />
                                <Label x:Name="PendienteValorLabel" Text="S/ 0.00" FontSize="18" FontAttributes="Bold" TextColor="#DC2626" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                <Label Text="Cuota semanal" FontSize="12" TextColor="#6B7280" HorizontalTextAlignment="End" />
                                <Label x:Name="CuotaValorLabel" Text="S/ 0.00" FontSize="18" FontAttributes="Bold" TextColor="#16A34A" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label x:Name="PrestamoInfoLabel" FontSize="12" TextColor="#9CA3AF" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="MONTO DEL PAGO" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" Padding="16,10">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="S/" FontSize="26" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center" />
                                <Entry
                                    x:Name="MontoEntry"
                                    Placeholder="100.00"
                                    Keyboard="Numeric"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    ClearButtonVisibility="WhileEditing"
                                    HorizontalOptions="Fill" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Padding="12" BackgroundColor="#FEF3C7" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Desglose FIFO" FontSize="13" FontAttributes="Bold" TextColor="#92400E" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" x:Name="DesgloseSemanalLabel" Text="Semanal" FontSize="13" TextColor="#6B7280" />
                                    <Label Grid.Column="1" x:Name="DesgloseSemanalValor" Text="S/ 0.00" FontSize="14" FontAttributes="Bold" TextColor="#D97706" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Acumulado interés" FontSize="13" TextColor="#6B7280" />
                                    <Label Grid.Column="1" x:Name="DesgloseAcumuladoValor" Text="S/ 0.00" FontSize="14" FontAttributes="Bold" TextColor="#DC2626" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="FECHA DE VENCIMIENTO" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="−7 días" Clicked="OnDiaMenosClicked" BackgroundColor="#F3F4F6" TextColor="#374151" CornerRadius="10" HeightRequest="44" />
                            <Button Grid.Column="1" Text="Últ. vto" Clicked="OnUltimoVencimientoClicked" BackgroundColor="#DBEAFE" TextColor="#1D4ED8" FontAttributes="Bold" CornerRadius="10" HeightRequest="44" />
                            <Button Grid.Column="2" Text="+7 días" Clicked="OnDiaMasClicked" BackgroundColor="#F3F4F6" TextColor="#374151" CornerRadius="10" HeightRequest="44" />
                        </Grid>
                        <Border StrokeShape="RoundRectangle 12" Stroke="#E5E7EB" Padding="14,10">
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="ic_calendar.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Label x:Name="FechaEntry" Text="" FontSize="16" TextColor="#111827" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="COMPROBANTE (OPCIONAL)" FontSize="12" FontAttributes="Bold" TextColor="#6B7280" CharacterSpacing="1" />
                        <Entry
                            x:Name="ComprobanteEntry"
                            Placeholder="N° de comprobante"
                            ClearButtonVisibility="WhileEditing" />
                        <Editor
                            x:Name="ObservacionesEditor"
                            Placeholder="Observaciones..."
                            AutoSize="TextChanges" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14,12" BackgroundColor="#DBEAFE" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="ic_info_p.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Start" />
                        <Label FontSize="13" TextColor="#1E3A8A">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Regla FIFO: " FontAttributes="Bold" />
                                    <Span Text="El pago se aplica primero a interés acumulado, luego a capital." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <Button
                    x:Name="GuardarButton"
                    Text="✓  Aplicar pago"
                    BackgroundColor="#1D4ED8"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54"
                    Clicked="OnGuardarClicked" />

                <ActivityIndicator
                    x:Name="CargandoIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#1D4ED8"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="#DC2626"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
