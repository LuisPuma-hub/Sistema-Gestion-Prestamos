<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemaPrestamos.Mobile.Views.PerfilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    BackgroundColor="#F8F7FC"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border
                BackgroundColor="#512BD4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,28,28"
                Padding="16,48,16,32">
                <Grid ColumnDefinitions="Auto,*">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        FontSize="22"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        VerticalOptions="Center"
                        Clicked="OnVolverClicked" />
                    <Label
                        Grid.Column="1"
                        Text="Mi perfil"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <VerticalStackLayout Padding="16,-40,16,16" Spacing="14">

                <Border Padding="20,18" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="4">
                        <Border
                            HeightRequest="72" WidthRequest="72"
                            HorizontalOptions="Center"
                            BackgroundColor="#EDE9FE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 36">
                            <Label
                                x:Name="AvatarLabel"
                                Text="C"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#512BD4"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            x:Name="NombreLabel"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#111827"
                            HorizontalTextAlignment="Center" />
                        <Label
                            x:Name="EmailLabel"
                            FontSize="14"
                            TextColor="#6B7280"
                            HorizontalTextAlignment="Center" />
                        <Border
                            Padding="12,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            HorizontalOptions="Center"
                            BackgroundColor="#EDE9FE">
                            <Label
                                x:Name="RolLabel"
                                Text=""
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#512BD4"
                                HorizontalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="6,4" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="12,12">
                        <Label Grid.Column="0" Text="✉" FontSize="18" TextColor="#6B7280" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Correo" FontSize="12" TextColor="#9CA3AF" />
                                <Label x:Name="EmailDetalleLabel" Text="" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F3F4F6" Margin="12,0" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="12,12">
                            <Label Grid.Column="0" Text="✓" FontSize="18" FontAttributes="Bold" TextColor="#6B7280" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Rol" FontSize="12" TextColor="#9CA3AF" />
                                <Label x:Name="RolDetalleLabel" Text="" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F3F4F6" Margin="12,0" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="12,12">
                            <Label Grid.Column="0" Text="ⓘ" FontSize="18" TextColor="#6B7280" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Versión app" FontSize="12" TextColor="#9CA3AF" />
                                <Label x:Name="VersionLabel" Text="Sistema de Préstamos v1.0" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="6,4" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Grid
                        x:Name="BiometriaGrid"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12"
                        Padding="12,12"
                        IsVisible="False">
                        <Label Grid.Column="0" Text="◉" FontSize="18" TextColor="#6B7280" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="Desbloqueo con huella" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                            <Label Text="Biometría disponible" FontSize="12" TextColor="#9CA3AF" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="2"
                            x:Name="BiometriaSwitch"
                            OnColor="#512BD4"
                            VerticalOptions="Center"
                            Toggled="OnBiometriaToggled" />
                    </Grid>
                </Border>

                <Button
                    x:Name="CambiarClaveButton"
                    Text="Cambiar contraseña"
                    BackgroundColor="White"
                    TextColor="#512BD4"
                    FontAttributes="Bold"
                    BorderColor="#512BD4"
                    BorderWidth="1.5"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnCambiarClaveClicked" />

                <Button
                    x:Name="CerrarSesionButton"
                    Text="Cerrar sesión"
                    BackgroundColor="#FEE2E2"
                    TextColor="#DC2626"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    Clicked="OnCerrarSesionClicked" />

                <ActivityIndicator
                    x:Name="CargandoIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    Color="#512BD4"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="#DC2626"
                    IsVisible="False"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
